{
    "luci-app-singbox-ui": {
        "description": "Singbox-UI management access",
        "read": {
            "session": ["access"],
            "file": {
                "/etc/init.d/sing-box": ["exec"],
                "/etc/init.d/*": ["read"],
                "/etc/sing-box": ["list"],
                "/etc/sing-box/*": ["read"],
                "/etc/singbox-ui": ["list"],
                "/etc/singbox-ui/*": ["read"],
                "/usr/bin/sing-box": ["exec"],
                "/tmp/*": ["read"],
                "/sbin/logread": ["exec"]
            },
            "uci": []
        },
        "write": {
            "file": {
                "/etc/sing-box/*": ["write"],
                "/etc/singbox-ui/*": ["write"],
                "/tmp/*": ["write"],
                "/usr/libexec/singbox-ui-helper": ["exec"]
            },
            "uci": []
        }
    }
}
