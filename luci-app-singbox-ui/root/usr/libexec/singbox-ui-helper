#!/bin/sh
set -eu

config_dir="${SINGBOX_UI_CONFIG_DIR:-/etc/sing-box}"
template_file="${SINGBOX_UI_TEMPLATE_FILE:-/etc/singbox-ui/template.json}"
template_dir="${SINGBOX_UI_TEMPLATE_DIR:-${template_file%/*}/templates}"

valid_name() {
	case "$1" in
		''|.*|*/*|*\\*) return 1 ;;
		*.json) return 0 ;;
		*) return 1 ;;
	esac
}

valid_prefix() {
	case "$1" in
		/tmp/.sbui-*-) ;;
		*) return 1 ;;
	esac
	case "$1" in
		*..*|/tmp/.sbui-*/*|*[!A-Za-z0-9/.-]*) return 1 ;;
		*) return 0 ;;
	esac
}

valid_destination() {
	case "$1" in
		"$template_file") return 0 ;;
		"$template_dir"/*/*.json) return 1 ;;
		"$template_dir"/*.json)
			valid_name "${1##*/}"
			return
			;;
		"$config_dir"/*/*.json) return 1 ;;
		"$config_dir"/*.json)
			valid_name "${1##*/}"
			return
			;;
		/tmp/sbui-check-*.json)
			case "$1" in
				*..*|/tmp/sbui-check-*/*|*[!A-Za-z0-9/.-]*) return 1 ;;
				*) return 0 ;;
			esac
			;;
		*) return 1 ;;
	esac
}

case "${1:-}" in
	ensure-dir)
		mkdir -p "$config_dir" "$template_dir"
		;;
	activate|apply)
		name="${2:-}"
		valid_name "$name"
		cp "$config_dir/$name" "$config_dir/config.json.sbui-tmp.$$"
		chmod 0600 "$config_dir/config.json.sbui-tmp.$$"
		mv -f "$config_dir/config.json.sbui-tmp.$$" "$config_dir/config.json"
		;;
	merge)
		prefix="${2:-}"
		destination="${3:-}"
		valid_prefix "$prefix"
		valid_destination "$destination"
		found=0
		for fragment in "$prefix"*; do
			[ -f "$fragment" ] && found=1
		done
		if [ "$found" -ne 1 ]; then
			echo "No data fragments for $prefix" >&2
			exit 1
		fi
		# Fragments are plain text (busybox on OpenWrt may lack base64). They are
		# joined into a temp file next to the destination, which is renamed only
		# on success, so a broken transfer never truncates the existing file.
		tmp="$destination.sbui-tmp.$$"
		trap 'rm -f "$tmp"' EXIT
		status=0
		: > "$tmp"
		for fragment in "$prefix"*; do
			[ -f "$fragment" ] || continue
			cat "$fragment" >> "$tmp" || { status=$?; break; }
		done
		rm -f "$prefix"*
		if [ "$status" -ne 0 ] || [ ! -s "$tmp" ]; then
			echo "Invalid data for $destination" >&2
			exit 1
		fi
		chmod 0600 "$tmp"
		mv -f "$tmp" "$destination"
		;;
	read-chunk)
		# rpcd file.read refuses files of 256 KiB and more, so the UI reads large
		# files through this command: up to 64 KiB from <offset>, never ending
		# inside a UTF-8 sequence. Empty output means end of file.
		source="${2:-}"
		offset="${3:-0}"
		valid_destination "$source"
		case "$offset" in
			''|*[!0-9]*) echo "Invalid offset: $offset" >&2; exit 2 ;;
		esac
		if [ ! -f "$source" ]; then
			echo "No such file: $source" >&2
			exit 4
		fi
		command -v ucode >/dev/null 2>&1 || { echo "ucode is required to read large files" >&2; exit 1; }
		exec ucode -e '
			let fs = require("fs");
			let f = fs.open(ARGV[0], "r");
			if (!f) { warn(fs.error(), "\n"); exit(1); }
			f.seek(+ARGV[1]);
			let max = 65536, data = f.read(max + 3) ?? "";
			f.close();
			if (length(data) > max) {
				let cut = max;
				while (cut > 0 && (ord(data, cut) & 0xC0) == 0x80) cut--;
				data = substr(data, 0, cut);
			}
			print(data);
		' -- "$source" "$offset"
		;;
	cleanup)
		prefix="${2:-}"
		valid_prefix "$prefix"
		rm -f "$prefix"*
		;;
	*)
		echo "Unsupported operation: ${1:-<empty>}" >&2
		exit 2
		;;
esac
